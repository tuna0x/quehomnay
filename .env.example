PORT=5001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/quehomnay
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=quehomnay

# Experiential Labs AI (GPT-5.6 Luna)
EXPERIENTIAL_API_KEY=xpl_your_api_key_here
EXPERIENTIAL_API_BASE=https://api.experientiallabs.ai/v1

AUTH_SESSION_DAYS=30

# Optional first-deploy admin bootstrap (never commit real credentials)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_NAME=Quản trị viên
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

EXPERIENTIAL_MODEL=gpt-5.6-luna

